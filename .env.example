PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/studiospace

# Better Auth secret (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or: npx auth secret
BETTER_AUTH_SECRET=replace_with_long_random_secret_min_32_chars
BETTER_AUTH_URL=http://localhost:5000

# App JWT secret (Challenge 1) — can be same as BETTER_AUTH_SECRET or separate
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
